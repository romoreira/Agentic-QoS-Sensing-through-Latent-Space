# Four-slice UPF/BESS audit plan. Source this file in the BESS host scripts.
# Same TEIDs and UE IPs as the TRex profile.

GNB_IP=192.168.70.2
UPF_N3_IP=192.168.70.1
DN_IP=192.168.80.2

TEID_GOLD=1
TEID_SILVER=11
TEID_BRONZE=21
TEID_NOISE=31

UE_GOLD=10.250.0.1
UE_SILVER=10.250.0.2
UE_BRONZE=10.250.0.3
UE_NOISE=10.250.0.4

# Initial MBRs. The future DQN will manipulate only gold, silver, bronze.
MBR_GOLD_KBPS=200000
MBR_SILVER_KBPS=100000
MBR_BRONZE_KBPS=50000
MBR_NOISE_KBPS=50000

# Edit these names to match your BESS-UPF deployment.
N3_PORT_NAME=n3
N6_PORT_NAME=n6
BESSCTL=bessctl
PFCPCTL=pfcpctl
